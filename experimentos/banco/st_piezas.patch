+    def _wilder(self, x, n):
+        out = np.full(len(x), np.nan)
+        if len(x) <= n:
+            return out
+        out[n] = np.nanmean(x[1:n + 1])
+        for i in range(n + 1, len(x)):
+            out[i] = out[i - 1] + (x[i] - out[i - 1]) / n
+        return out
+
+    def _tr(self):
+        pc = np.r_[self.c[0], self.c[:-1]]
+        return np.maximum(self.h - self.l, np.maximum(np.abs(self.h - pc), np.abs(self.l - pc)))
+
+    def supertrend(self, n, m):
+        """Dirección del Supertrend (1 = alcista, -1 = bajista) con ATR de Wilder de n velas y m veces."""
+        def f():
+            atr = self._wilder(self._tr(), n)
+            mid = (self.h + self.l) / 2
+            ub, lb = mid + m * atr, mid - m * atr
+            fu, fl = ub.copy(), lb.copy()
+            d = np.zeros(self.n)
+            C = self.c
+            for i in range(1, self.n):
+                if np.isnan(atr[i]):
+                    continue
+                fu[i] = ub[i] if (np.isnan(fu[i - 1]) or ub[i] < fu[i - 1] or C[i - 1] > fu[i - 1]) else fu[i - 1]
+                fl[i] = lb[i] if (np.isnan(fl[i - 1]) or lb[i] > fl[i - 1] or C[i - 1] < fl[i - 1]) else fl[i - 1]
+                prev = d[i - 1] if d[i - 1] != 0 else 1
+                d[i] = (-1 if C[i] < fl[i] else 1) if prev == 1 else (1 if C[i] > fu[i] else -1)
+            return d
+        return self._memo(("st", n, m), f)
+
+    def adx(self, n):
+        """(ADX, +DI, -DI) de Wilder de n velas."""
+        def f():
+            up = np.r_[0, self.h[1:] - self.h[:-1]]
+            dn = np.r_[0, self.l[:-1] - self.l[1:]]
+            pdm = np.where((up > dn) & (up > 0), up, 0.0)
+            mdm = np.where((dn > up) & (dn > 0), dn, 0.0)
+            atr = self._wilder(self._tr(), n)
+            with np.errstate(invalid="ignore", divide="ignore"):
+                pdi = 100 * self._wilder(pdm, n) / atr
+                mdi = 100 * self._wilder(mdm, n) / atr
+                dx = 100 * np.abs(pdi - mdi) / (pdi + mdi)
+            a = np.full(self.n, np.nan)
+            ok = ~np.isnan(dx)
+            if ok.sum() > n:
+                a[ok] = self._wilder(dx[ok], n)
+            return a, pdi, mdi
+        return self._memo(("adx", n), f)
+
